# Orbit - copy to `.env.local` for local development (never commit real secrets).
# See brief.md and build-plan.md for stack context.
#
# Firebase web config below matches project `orbit-oaklin`. Restrict the API key in
# Firebase Console (API key restrictions) if the repo is public.

# -----------------------------------------------------------------------------
# Public app URL (used in survey invite links, magic links, etc.)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Firebase - client SDK (bundled in the browser; from Firebase Console > Project settings > Your apps)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAtk_PEYbpcq_W1Kml_F_5Jy4SYLbMZ_m8
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=orbit-oaklin.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=orbit-oaklin
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=orbit-oaklin.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=834035713866
NEXT_PUBLIC_FIREBASE_APP_ID=1:834035713866:web:bcb1db5fcdde30acda63b3
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-CZ9YXJ6QDR

# -----------------------------------------------------------------------------
# Firebase Admin - server-only (from a service account JSON; never expose to the client)
# Use either the split vars below OR a single JSON string, depending on lib/firebase-admin.ts
# -----------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=orbit-oaklin
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key with literal \n for newlines, or use a single-line JSON approach in code
FIREBASE_ADMIN_PRIVATE_KEY=

# Alternative: entire service account as one line (if your code reads this)
# FIREBASE_SERVICE_ACCOUNT_JSON=

# -----------------------------------------------------------------------------
# Anthropic - server-only (Claude for analysis and benchmark supplementation)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Optional - default in scripts/test-anthropic.mjs is claude-haiku-4-5 (smoke test)
# For production analysis, consider claude-sonnet-4-6 or claude-opus-4-7
# ANTHROPIC_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# Email - transactional invites (e.g. Resend per build-plan.md)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# From address must be a verified domain/sender in Resend
EMAIL_FROM=Orbit <noreply@example.com>
